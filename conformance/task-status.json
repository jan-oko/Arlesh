        "kind": "agentic",
        "status": "done"
      }
    },
    {
      "status": {
        "kind": "agentic",
        "status": "todo"
      },
      "agentic": false,
      "converted": {
        "kind": "ordinary",
        "status": "todo"
      }
    },
    {
      "status": {
        "kind": "agentic",
        "status": "todo"
      },
      "agentic": true,
      "converted": {
        "kind": "agentic",
        "status": "todo"
      }
    },
    {
      "status": {
        "kind": "agentic",
        "status": "on_agent"
      },
      "agentic": false,
      "converted": null
    },
    {
      "status": {
        "kind": "agentic",
        "status": "on_agent"
      },
      "agentic": true,
      "converted": {
        "kind": "agentic",
        "status": "on_agent"
      }
    },
    {
