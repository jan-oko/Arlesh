          "passed": true,
          "done": true
        }
      ],
      "folded": [
        {
          "id": "habitrun-1-virtual",
          "level": "run",
          "tally": {
            "passed": 3,
            "done": 2,
            "missed": 1
          },
          "children": [
            "i1",
            "i2",
            "i3"
