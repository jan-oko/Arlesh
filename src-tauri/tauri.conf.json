{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arlesh",
  "version": "0.3.0",
  "identifier": "com.atai.arlesh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arlesh",
        "width": 800,
        "height": 600,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
